{
    "name": "@battlestack/tui",
    "version": "0.9.0",
    "description": "Battlestack terminal-UI layer: banner, spinner, colors, prompts, and scaffold-selection helpers shared by the CLI and presets.",
    "license": "MIT",
    "author": "SevenLab",
    "homepage": "https://github.com/SevenLabnl/battlestack#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SevenLabnl/battlestack.git",
        "directory": "packages/tui"
    },
    "bugs": {
        "url": "https://github.com/SevenLabnl/battlestack/issues"
    },
    "keywords": [
        "battlestack",
        "terminal",
        "tui",
        "prompts",
        "cli"
    ],
    "engines": {
        "node": ">=24"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "ora": "^9.4.1",
        "picocolors": "^1.1.1",
        "prompts": "^2.4.2"
    },
    "peerDependencies": {
        "@battlestack/core": "workspace:*"
    },
    "devDependencies": {
        "@battlestack/core": "workspace:*",
        "@types/prompts": "^2.4.9"
    }
}

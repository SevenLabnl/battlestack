{
    "name": "@battlestack/theme",
    "version": "1.2.0",
    "description": "Battlestack Design System Nuxt — the Nuxt UI theme: token values for light and dark, brand assets, and the Logo lockup. No components; Nuxt UI is the component library.",
    "license": "MIT",
    "author": "SevenLab",
    "homepage": "https://github.com/SevenLabnl/battlestack#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SevenLabnl/battlestack.git",
        "directory": "packages/theme"
    },
    "bugs": {
        "url": "https://github.com/SevenLabnl/battlestack/issues"
    },
    "keywords": [
        "battlestack",
        "nuxt",
        "nuxt4",
        "nuxt-ui",
        "design-system",
        "theme",
        "tailwind",
        "design-tokens"
    ],
    "engines": {
        "node": ">=24"
    },
    "type": "module",
    "main": "./nuxt.config.ts",
    "exports": {
        ".": "./nuxt.config.ts",
        "./tokens.css": "./tokens.css",
        "./package.json": "./package.json"
    },
    "files": [
        "components",
        "nuxt.config.ts",
        "tokens.css"
    ],
    "sideEffects": [
        "*.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@nuxt/kit": "^4.5.2"
    },
    "scripts": {
        "check:contrast": "node scripts/check-contrast.mjs",
        "check:contract": "node scripts/check-contract.mjs"
    }
}

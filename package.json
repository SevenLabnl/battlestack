{
    "name": "battlestack-split-prototype",
    "private": true,
    "type": "module",
    "scripts": {
        "battlestack": "tsx packages/cli/src/index.ts",
        "demo": "tsx scripts/demo.ts",
        "tsc": "tsc --noEmit",
        "bump": "tsx scripts/bump-check.ts",
        "bump:check": "tsx scripts/bump-check.ts --check",
        "version:print": "node scripts/release-version.mjs --print",
        "version:check": "node scripts/release-version.mjs --check",
        "version:set": "node scripts/release-version.mjs --set",
        "version:bump": "node scripts/release-version.mjs --bump",
        "version:changelog": "node scripts/release-version.mjs --changelog",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "tsc -b tsconfig.build.json && node scripts/build-post.mjs",
        "build:clean": "tsc -b tsconfig.build.json --clean",
        "pack:smoke": "pnpm build && node scripts/pack-smoke.mjs",
        "pack:smoke:matrix": "pnpm build && node scripts/pack-smoke-matrix.mjs",
        "race:migrate-lock": "node scripts/migrate-lock-race.mjs",
        "race:replicas": "node scripts/replica-race.mjs"
    },
    "devDependencies": {
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11",
        "@types/node": "^26.4.0"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.8.0"
}
